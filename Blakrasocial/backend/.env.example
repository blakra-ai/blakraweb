# ---------------------------------------------------------------------------
# Blakrasocial backend configuration. Copy to .env for local development.
# NEVER commit real values. In production, inject these from your secret store.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# --- Ayrshare (Business plan). Dashboard -> API Key (Primary Profile). ---
AYRSHARE_API_KEY=replace-me
AYRSHARE_BASE_URL=https://api.ayrshare.com/api
# Optional: your white-label linking domain registered with Ayrshare.
AYRSHARE_LINK_DOMAIN=
# "facebook" = Instagram Business/Creator linked through a Facebook Page (required by our rules).
AYRSHARE_INSTAGRAM_LINK_METHOD=facebook
# Set true only after Ayrshare enables the Messages API / WhatsApp (private beta) for your account.
AYRSHARE_MESSAGING_ENABLED=false

# --- Webhooks: Ayrshare calls PUBLIC_WEBHOOK_URL with publish results, signed with this secret. ---
PUBLIC_WEBHOOK_URL=
AYRSHARE_WEBHOOK_SECRET=

# --- Caller authentication (access tokens issued by the host platform). Set ONE of: ---
# Recommended: asymmetric keys published as JWKS by your auth server.
AUTH_JWT_JWKS_URL=
AUTH_JWT_ALGORITHMS=HS256        # RS256/ES256 with JWKS; HS256 with a shared secret
# Alternative: shared HMAC secret (>= 32 chars) known only to the host backend and this API.
AUTH_JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
AUTH_JWT_ISSUER=https://host.blakra.local
AUTH_JWT_AUDIENCE=blakrasocial
# Claim that carries the customer's Ayrshare profileKey.
AUTH_PROFILE_KEY_CLAIM=profile_key

# Server-to-server keys for POST /profiles (comma separated, each >= 32 chars).
SERVICE_API_KEYS=dev-only-service-key-change-me-000000000

# --- Media ---
# Signs upload references so only files uploaded by the same customer can be published.
MEDIA_SIGNING_SECRET=dev-only-media-secret-change-me-00000000
FFPROBE_PATH=ffprobe
MEDIA_PROBE_TIMEOUT_SECONDS=30

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBHOOK_MAX_AGE_SECONDS=300

# --- Infrastructure ---
# Set when running more than one instance, so double-post protection is shared.
REDIS_URL=
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
