# ---------------------------------------------------------------------------
# Blakrasocial backend configuration. Copy to .env for local development.
# NEVER commit real values. In production, inject these from your secret store.
# Random secret:          python -c "import secrets; print(secrets.token_urlsafe(48))"
# Random encryption key:  python -c "import os,base64; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# How we reach the networks:
#   direct   = our own login + official APIs (free; needs the database, storage and network apps below)
#   ayrshare = Ayrshare Business plan (paid; set AYRSHARE_API_KEY)
PUBLISHER=direct

# =========================== direct mode ===========================
# Public HTTPS address of this API. Networks send users back to <this>/oauth/<network>/callback,
# and that exact URL must be registered in each network's app settings.
PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://blakra:blakra@localhost:5432/blakrasocial
# Encrypts customers' tokens at rest. "id:base64(32 bytes)", comma separated; the first one encrypts.
# Rotate by putting a new key first and keeping the old one after it. Losing every key = customers reconnect.
CREDENTIALS_ENCRYPTION_KEYS=dev:ZGV2LW9ubHkta2V5LW5ldmVyLXVzZS1pbi1wcm9kISE=
# Run the publisher inside the API process (simplest). Set false when you run "python -m blakrasocial.worker".
RUN_WORKER_IN_API=true
WORKER_POLL_SECONDS=5

# File storage: any S3-compatible bucket whose files are publicly readable over HTTPS
# (networks download from it). Cloudflare R2 free tier: 10 GB, no download fees.
STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=blakrasocial-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_PUBLIC_BASE_URL=https://pub-REPLACE.r2.dev

# Network apps. A network appears in the app only when both its id and secret are set.
# Meta (developers.facebook.com): one app; Instagram has its own app id/secret under "Instagram > API setup".
META_GRAPH_VERSION=v26.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok (developers.tiktok.com): Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# LinkedIn (linkedin.com/developers): products "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610

# =========================== ayrshare mode ===========================
AYRSHARE_API_KEY=
AYRSHARE_BASE_URL=https://api.ayrshare.com/api
AYRSHARE_LINK_DOMAIN=
AYRSHARE_INSTAGRAM_LINK_METHOD=facebook
AYRSHARE_MESSAGING_ENABLED=false
PUBLIC_WEBHOOK_URL=
AYRSHARE_WEBHOOK_SECRET=

# =========================== shared ===========================
# Caller authentication (access tokens issued by the host platform). Set ONE of:
# Recommended: asymmetric keys published as JWKS by your auth server.
AUTH_JWT_JWKS_URL=
AUTH_JWT_ALGORITHMS=HS256        # RS256/ES256 with JWKS; HS256 with a shared secret
# Alternative: shared HMAC secret (>= 32 chars) known only to the host backend and this API.
AUTH_JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
AUTH_JWT_ISSUER=https://host.blakra.local
AUTH_JWT_AUDIENCE=blakrasocial
# Claim that carries the customer's profile key.
AUTH_PROFILE_KEY_CLAIM=profile_key

# Server-to-server keys for POST /profiles and PUT /profiles/whatsapp (comma separated, each >= 32 chars).
SERVICE_API_KEYS=dev-only-service-key-change-me-000000000

# Signs upload references so only files uploaded by the same customer can be published.
MEDIA_SIGNING_SECRET=dev-only-media-secret-change-me-00000000
FFPROBE_PATH=ffprobe
MEDIA_PROBE_TIMEOUT_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBHOOK_MAX_AGE_SECONDS=300

# Set when running more than one API instance, so double-post protection is shared.
REDIS_URL=
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
