# Backend base URL (no trailing slash). In production behind Caddy this is just /api (same site).
VITE_API_BASE_URL=http://localhost:8000
# JWT claim that carries the customer's profile key (only for a host platform that embeds the app).
VITE_PROFILE_KEY_CLAIM=profile_key
# Shown on the privacy / terms / data-deletion pages. Use an inbox you actually read.
VITE_CONTACT_EMAIL=
# Your business name as it should appear on the legal pages.
VITE_COMPANY_NAME=Blakra
