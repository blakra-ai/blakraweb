# Backend base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000
# JWT claim that carries the customer's profile key (must match backend AUTH_PROFILE_KEY_CLAIM).
VITE_PROFILE_KEY_CLAIM=profile_key
# DEVELOPMENT ONLY: a token from `backend/scripts/issue_dev_token.py`.
# In production the host platform supplies tokens through configureSession(); leave this empty.
VITE_DEV_ACCESS_TOKEN=
