# Example nginx server block for the static build in dist/.
# Not applied automatically: copy, adapt the paths and certificates, test with `nginx -t`.

server {
    listen 443 ssl;
    http2 on;
    server_name blakra.us;

    ssl_certificate     /etc/letsencrypt/live/blakra.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blakra.us/privkey.pem;

    root /var/www/blakra/dist;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json application/xml;

    # nginx drops server-level add_header lines inside any location that sets its own,
    # so the security headers live in one snippet included everywhere.
    include /etc/nginx/snippets/blakra-headers.conf;

    # Hashed build assets never change: cache them for a year.
    location /assets/ {
        include /etc/nginx/snippets/blakra-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Pages are prerendered folders: /investors/ -> investors/index.html.
    location / {
        include /etc/nginx/snippets/blakra-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}

server {
    listen 80;
    server_name blakra.us www.blakra.us;
    return 301 https://blakra.us$request_uri;
}

# The header snippet is deploy/blakra-headers.conf: copy it to /etc/nginx/snippets/.
# Each language has its own 404 page:
#   location /de/ { include /etc/nginx/snippets/blakra-headers.conf; try_files $uri $uri/ =404; error_page 404 /de/404.html; }
#   (the same for /fr/ and /es/)
